    "mummymaze": {
      "folder": "Mummy Maze Deluxe",
      "registry": { "key": "PopCap\\MummyMaze", "hives": ["vs", "hklm", "hkcu"], "sets": ["base", "app"],
        "values": ["LastScoreName=sz", "Speed=dword", "Name=dword", "Clock=dword", "Ankh=dword", "TwoMummyNag=dword", "GateNag=dword", "TrapNag=dword",
          "RedNag=dword", "ScorpNag=dword", "DarkNag=dword", "AnkhNag=dword"] },
