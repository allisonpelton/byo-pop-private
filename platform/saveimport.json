        { "from": "data/saves/classic.sav", "to": "classic.sav", "what": "the classic game in progress" },
        { "from": "data/saves/adv#.sav", "to": "adv#.sav", "what": "an adventure" }
      ]
    },
    "tiptop": {
      "folder": "TipTop Deluxe",
      "note": "TipTop keeps nothing in the registry that the port uses.",
      "files": [
        { "from": "Preferences.dat", "to": "Preferences.dat", "what": "the high scores and the settings" },
        { "from": "savegame.dat", "to": "savegame.dat", "what": "the game in progress" }
      ]
