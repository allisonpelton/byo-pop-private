{
  "format": "byo-pop save import table",
  "version": 1,
  "doc": "The one source of truth for importing the player's saves from an installed original game (docs/WEB_PLAYER.md, 'Importing saves from an installed game'). The web listing page (web/saveimport.js, with this table as saveimport-table.js) and the native games (platform/SaveImport.cpp, with this table compiled in) both read it. Nothing outside this table is ever taken. A value or file pattern matches without regard to case; '*' stands for any characters inside one path part, '#' for digits. Registry value paths are relative to the game's key and use backslashes; file paths use slashes and are relative to the folder that holds the saves.",
  "hives": {
    "vs": "HKEY_CURRENT_USER\\Software\\Classes\\VirtualStore\\MACHINE\\SOFTWARE\\<WOW6432Node\\><key>: where Windows redirects the writes of a game that was not run as administrator",
    "hklm": "HKEY_LOCAL_MACHINE\\SOFTWARE\\<WOW6432Node\\><key>: the 32-bit view that a 32-bit original uses",
    "hkcu": "HKEY_CURRENT_USER\\Software\\<key>"
  },
  "valueSets": {
    "base": ["MusicVolume=dword", "SfxVolume=dword", "Muted=dword", "ScreenMode=dword", "CustomCursors=dword", "WaitForVSync=dword", "PreferredX=dword", "PreferredY=dword"],
    "app": ["TimesPlayed=dword", "TimesExecuted=dword"]
  },
  "skipValues": {
    "InstallPath": "an installer or registration value, not a save",
    "FullInstallPath": "an installer or registration value, not a save",
    "RegisterLink": "an installer or registration value, not a save",
    "RegisterURL": "an installer or registration value, not a save",
    "PopCapURL": "an installer or registration value, not a save",
    "ReferId": "an installer or registration value, not a save",
    "DownloadId": "an installer or registration value, not a save",
    "DontUpdate": "an installer or registration value, not a save",
    "NoPopLink": "an installer or registration value, not a save",
    "Variation": "an installer or registration value, not a save",
    "PurchaseId": "an installer or registration value, not a save",
    "RegCode": "an installer or registration value, not a save",
    "RegName": "an installer or registration value, not a save",
    "InstallTag": "an installer or registration value, not a save",
    "InstallFlags": "an installer or registration value, not a save",
    "InstallCheck": "an installer or registration value, not a save",
    "PartnerName": "an installer or registration value, not a save",
    "RegistryDataLocation": "an installer or registration value, not a save",
    "InProgress": "the running flag of the original; the port sets its own",
    "LastVerCheckQueryTime": "the original's update-check time, which the port does not use",
    "ITSuccess": "the original's Internet test result, which the port does not use",
    "test": "the original's registry write test",
    "Test3D\\*": "the original's graphics hardware test",
    "TotalBooks": "worked out again from the game's scripts at each start",
    "LastRanVersion": "the version of the original; the port writes its own"
  },
  "games": {
    "bejeweled": {
      "folder": "Bejeweled Deluxe", "steam": "Bejeweled Deluxe", "appdata": "Bejeweled",
      "registry": { "key": "PopCap\\Bejeweled", "hives": ["hkcu", "vs", "hklm"], "sets": ["base", "app"], "values": ["LastScoreName=sz"] },
      "files": [
        { "from": "userdata/savegame.dat", "to": "savegame.dat", "what": "the game in progress" },
        { "from": "userdata/hiscores.dat", "to": "hiscores.dat", "what": "the high scores" }
      ]
    },
    "bigmoney": {
      "folder": "Big Money Deluxe", "steam": "Big Money Deluxe",
      "registry": { "key": "PopCap\\BigMoney", "hives": ["vs", "hklm", "hkcu"], "sets": ["base", "app"],
        "values": ["LastScoreName=sz", "SkillLevel=dword", "GameType=dword", "DontShowHelp*=dword"] },
      "files": [
        { "from": "savegame.dat", "to": "savegame.dat", "what": "the game in progress" },
        { "from": "hiscores.dat", "to": "hiscores.dat", "what": "the high scores" }
      ]
    },
    "bookworm": {
      "folder": "BookWorm Deluxe", "steam": "BookWorm Deluxe",
      "note": "The port follows the 2004 edition of the original Windows game (the one that keeps its players under the registry key Users). The Steam edition is a later build that keeps each player in players\\<name>\\profile.dat and scores.dat; the port does not read those.",
      "registry": { "key": "PopCap\\BookWorm", "hives": ["vs", "hklm", "hkcu"], "sets": ["base", "app"],
        "values": ["Users\\User=sz", "Users\\*\\Alias=sz", "Users\\*\\ShowHelp=dword", "Users\\*\\ShowHints=dword", "Users\\*\\ShowDefs=dword", "Users\\*\\TimesPlayed=dword",
          "Scores\\Classic=hex", "Scores\\Action=hex", "Scores\\Best=hex", "Scores\\Longest=hex"] },
      "files": [
        { "from": "players/*/classic.dat", "to": "players/*/classic.dat", "what": "a player's classic game in progress" },
        { "from": "players/*/action.dat", "to": "players/*/action.dat", "what": "a player's action game in progress" }
      ],
      "skipFiles": [
        { "from": "players/*/profile.dat", "why": "the Steam edition's player file, in a layout the port does not read" },
        { "from": "players/*/scores.dat", "why": "the Steam edition's scores file, in a layout the port does not read" }
      ]
    },
    "noahsark": {
      "folder": "Noah's Ark Deluxe",
      "registry": { "key": "PopCap\\NoahsArk", "hives": ["vs", "hklm", "hkcu"], "sets": ["base", "app"],
        "values": ["LastScoreName=sz", "ShowHints=dword", "ShowTutorial=dword"] },
      "files": [
        { "from": "hiscores.dat", "to": "hiscores.dat", "what": "the high scores" }
      ],
      "skipFiles": [
        { "from": "data/savegame.dat", "why": "the port keeps the game in progress in another layout (its random number generator is not the original's), so the original's file cannot be continued" }
      ]
    },
    "sevenseas": {
