        "values": ["LastScoreName=sz", "BonusNag=dword", "WarnBlueNag=dword", "WarnGhostNag=dword", "WarnSerpNag=dword", "WarnWhirlNag=dword"] },
      "files": [
        { "from": "data/savegame.dat", "to": "savegame.dat", "what": "the game in progress" },
        { "from": "hiscores.dat", "to": "hiscores.dat", "what": "the high scores" }
      ]
    },
